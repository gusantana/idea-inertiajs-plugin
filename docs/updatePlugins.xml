<?xml version="1.0" encoding="UTF-8"?>
<!--
  Custom JetBrains plugin repository.

  Add this file's public URL in the IDE:
    Settings | Plugins | gear icon | Manage Plugin Repositories
    https://gusantana.github.io/idea-inertiajs-plugin/updatePlugins.xml

  On every release, add a <plugin> entry pointing to the release asset and bump the
  version. The newest entry wins; keep older entries only if their asset really has the
  same plugin id (the 0.2.0 asset predates the rename and still uses the old id).
-->
<plugins>
  <plugin id="io.github.gusantana.inertiajs"
          url="https://github.com/gusantana/idea-inertiajs-plugin/releases/download/v0.2.1/inertiajs-storm-0.2.1.zip"
          version="0.2.1">
    <idea-version since-build="262" until-build="263.*"/>
    <name>Inertia.js Storm</name>
    <vendor url="https://github.com/gusantana">gusantana</vendor>
    <description><![CDATA[
      Inertia.js support for PhpStorm 2026.2 and 2026.3: navigation from
      <code>Inertia::render()</code>, <code>inertia()</code> and <code>Route::inertia()</code>,
      page name completion, Svelte 5 <code>$props()</code> completion and an opt-in inspection
      for props the page does not declare.
    ]]></description>
    <change-notes><![CDATA[
      <h3>0.2.1</h3>
      <ul>
        <li>Support for PhpStorm and IntelliJ IDEA 2026.3 (263.*)</li>
      </ul>
    ]]></change-notes>
  </plugin>
</plugins>
